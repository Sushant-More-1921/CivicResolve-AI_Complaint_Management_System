{
  "name": "civicresolve",
  "version": "1.0.0",
  "private": true,
  "description": "CivicResolve - AI-Powered Citizen Grievance Redressal Platform",
  "scripts": {
    "frontend": "npm --prefix frontend run dev",
    "backend": "npm --prefix backend run dev",
    "ai": "python -m uvicorn app.main:app --app-dir ai-service --reload --port 8000",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:ai": "python -m uvicorn app.main:app --app-dir ai-service --reload --port 8000",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "lint:frontend": "npm --prefix frontend run lint",
    "test:ai": "python -m pytest ai-service/tests",
    "db:seed": "npm --prefix backend run db:seed"
  }
}
